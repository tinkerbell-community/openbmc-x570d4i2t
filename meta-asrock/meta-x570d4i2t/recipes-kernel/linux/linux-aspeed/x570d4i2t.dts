					timer7_default {
						function = "TIMER7";
						groups = "TIMER7";
					};

					timer8_default {
						function = "TIMER8";
						groups = "TIMER8";
					};

					txd1_default {
						function = "TXD1";
						groups = "TXD1";
						phandle = <0x0e>;
					};

					txd2_default {
						function = "TXD2";
						groups = "TXD2";
						phandle = <0x10>;
					};

					txd3_default {
						function = "TXD3";
						groups = "TXD3";
						phandle = <0x12>;
					};

					txd4_default {
						function = "TXD4";
						groups = "TXD4";
						phandle = <0x14>;
					};

					uart6_default {
						function = "UART6";
						groups = "UART6";
						phandle = <0x16>;
					};

					usbcki_default {
						function = "USBCKI";
						groups = "USBCKI";
					};

					usb2ah_default {
						function = "USB2AH";
						groups = "USB2AH";
						phandle = <0x07>;
					};

					usb2ad_default {
						function = "USB2AD";
						groups = "USB2AD";
						phandle = <0x09>;
					};

					usb11bhid_default {
						function = "USB11BHID";
						groups = "USB11BHID";
					};

					usb2bh_default {
						function = "USB2BH";
						groups = "USB2BH";
						phandle = <0x08>;
					};

					vgabiosrom_default {
						function = "VGABIOSROM";
						groups = "VGABIOSROM";
					};

					vgahs_default {
						function = "VGAHS";
						groups = "VGAHS";
					};

					vgavs_default {
						function = "VGAVS";
						groups = "VGAVS";
					};

					vpi24_default {
						function = "VPI24";
						groups = "VPI24";
					};

					vpo_default {
						function = "VPO";
						groups = "VPO";
					};

					wdtrst1_default {
						function = "WDTRST1";
						groups = "WDTRST1";
					};

					wdtrst2_default {
						function = "WDTRST2";
						groups = "WDTRST2";
					};
				};

				scratch {
					compatible = "aspeed,bmc-misc";

					dac_mux {
						offset = <0x2c>;
						bit-mask = <0x03>;
						bit-shift = <0x10>;
					};

					vga0 {
						offset = <0x50>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga1 {
						offset = <0x54>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga2 {
						offset = <0x58>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga3 {
						offset = <0x5c>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga4 {
						offset = <0x60>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga5 {
						offset = <0x64>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga6 {
						offset = <0x68>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};

					vga7 {
						offset = <0x6c>;
						bit-mask = <0xffffffff>;
						bit-shift = <0x00>;
					};
				};

				p2a-control {
					compatible = "aspeed,ast2500-p2a-ctrl";
					status = "disabled";
				};

				interrupt-controller@0 {
					#interrupt-cells = <0x01>;
					compatible = "aspeed,ast2500-scu-ic";
					reg = <0x18 0x04>;
					interrupts = <0x15>;
					interrupt-controller;
				};
			};

			hwrng@1e6e2078 {
				compatible = "timeriomem_rng";
				reg = <0x1e6e2078 0x04>;
				period = <0x01>;
				quality = <0x64>;
			};

			hace@1e6e3000 {
				compatible = "aspeed,ast2500-hace";
				reg = <0x1e6e3000 0x200 0x1e728000 0x1000>;
				interrupts = <0x04>;
				clocks = <0x02 0x0b 0x02 0x13>;
				clock-names = "yclk", "rsaclk";
				status = "disabled";
			};

			display@1e6e6000 {
				compatible = "aspeed,ast2500-gfx", "syscon";
				reg = <0x1e6e6000 0x1000>;
				reg-io-width = <0x04>;
				clocks = <0x02 0x0a>;
				resets = <0x02 0x09>;
				status = "disabled";
				interrupts = <0x19>;
				phandle = <0x0a>;
			};

			adc@1e6e9000 {
				compatible = "aspeed,ast2500-adc";
				reg = <0x1e6e9000 0xb0>;
				clocks = <0x02 0x1a>;
				resets = <0x02 0x02>;
				#io-channel-cells = <0x01>;
				status = "disabled";
			};

			video@1e700000 {
				compatible = "aspeed,ast2500-video";
				reg = <0x1e700000 0x300>;
				clocks = <0x02 0x03 0x02 0x00>;
				clock-names = "vclk", "eclk";
				interrupts = <0x07>;
				status = "disabled";
			};

			sram@1e720000 {
				compatible = "mmio-sram";
				reg = <0x1e720000 0x9000>;
			};

			gpio@1e780000 {
				#gpio-cells = <0x02>;
				gpio-controller;
				compatible = "aspeed,ast2500-gpio";
				reg = <0x1e780000 0x1000>;
				interrupts = <0x14>;
				gpio-ranges = <0x0c 0x00 0x00 0xdc>;
				clocks = <0x02 0x1a>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			rtc@1e781000 {
				compatible = "aspeed,ast2500-rtc";
				reg = <0x1e781000 0x18>;
				status = "disabled";
			};

			timer@1e782000 {
				compatible = "aspeed,ast2400-timer";
				reg = <0x1e782000 0x90>;
				interrupts = <0x10 0x11 0x12 0x23 0x24 0x25 0x26 0x27>;
				clocks = <0x02 0x1a>;
				clock-names = "PCLK";
			};

			serial@1e783000 {
				compatible = "ns16550a";
				reg = <0x1e783000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x09>;
				clocks = <0x02 0x0d>;
				resets = <0x0d 0x04>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e784000 {
				compatible = "ns16550a";
				reg = <0x1e784000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x0a>;
				clocks = <0x02 0x0f>;
				no-loopback-test;
				status = "okay";
			};

			watchdog@1e785000 {
				compatible = "aspeed,ast2500-wdt";
				reg = <0x1e785000 0x20>;
				clocks = <0x02 0x1a>;
			};

			watchdog@1e785020 {
				compatible = "aspeed,ast2500-wdt";
				reg = <0x1e785020 0x20>;
				clocks = <0x02 0x1a>;
			};

			watchdog@1e785040 {
				compatible = "aspeed,ast2500-wdt";
				reg = <0x1e785040 0x20>;
				clocks = <0x02 0x1a>;
				status = "disabled";
			};

			pwm-tacho-controller@1e786000 {
				compatible = "aspeed,ast2500-pwm-tacho";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x1e786000 0x1000>;
				clocks = <0x02 0x23>;
				resets = <0x02 0x05>;
				status = "disabled";
			};

			serial@1e787000 {
				compatible = "aspeed,ast2500-vuart";
				reg = <0x1e787000 0x40>;
				reg-shift = <0x02>;
				interrupts = <0x08>;
				clocks = <0x02 0x1a>;
				no-loopback-test;
				status = "disabled";
			};

			lpc@1e789000 {
				compatible = "aspeed,ast2500-lpc", "simple-mfd";
				reg = <0x1e789000 0x1000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e789000 0x1000>;

				lpc-bmc@0 {
					compatible = "aspeed,ast2500-lpc-bmc", "simple-mfd", "syscon";
					reg = <0x00 0x80>;
					reg-io-width = <0x04>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					ranges = <0x00 0x00 0x80>;

					kcs1@0 {
						compatible = "aspeed,ast2500-kcs-bmc";
						interrupts = <0x08>;
						kcs_chan = <0x01>;
						status = "disabled";
					};

					kcs2@0 {
						compatible = "aspeed,ast2500-kcs-bmc";
						interrupts = <0x08>;
						kcs_chan = <0x02>;
						status = "disabled";
					};

					kcs3@0 {
						compatible = "aspeed,ast2500-kcs-bmc";
						interrupts = <0x08>;
						kcs_chan = <0x03>;
						status = "disabled";
					};
				};

				lpc-host@80 {
					compatible = "aspeed,ast2500-lpc-host", "simple-mfd", "syscon";
					reg = <0x80 0x1e0>;
					reg-io-width = <0x04>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					ranges = <0x00 0x80 0x1e0>;

					kcs4@0 {
						compatible = "aspeed,ast2500-kcs-bmc";
						interrupts = <0x08>;
						kcs_chan = <0x04>;
						status = "disabled";
					};

					lpc-ctrl@0 {
						compatible = "aspeed,ast2500-lpc-ctrl";
						reg = <0x00 0x80>;
						clocks = <0x02 0x08>;
						status = "disabled";
					};

					lpc-snoop@0 {
						compatible = "aspeed,ast2500-lpc-snoop";
						reg = <0x00 0x80>;
						interrupts = <0x08>;
						status = "disabled";
					};

					lhc@20 {
						compatible = "aspeed,ast2500-lhc";
						reg = <0x20 0x24 0x48 0x08>;
						phandle = <0x0b>;
					};

					reset-controller@18 {
						compatible = "aspeed,ast2500-lpc-reset";
						reg = <0x18 0x04>;
						#reset-cells = <0x01>;
						phandle = <0x0d>;
					};

					ibt@c0 {
						compatible = "aspeed,ast2500-ibt-bmc";
						reg = <0xc0 0x18>;
						interrupts = <0x08>;
					};

					regs {
						compatible = "aspeed,bmc-misc";

						sio_2b {
							offset = <0xf0>;
							bit-mask = <0xff>;
							bit-shift = <0x18>;
						};

						sio_2a {
							offset = <0xf0>;
							bit-mask = <0xff>;
							bit-shift = <0x10>;
						};

						sio_29 {
							offset = <0xf0>;
							bit-mask = <0xff>;
							bit-shift = <0x08>;
						};

						sio_28 {
							offset = <0xf0>;
							bit-mask = <0xff>;
							bit-shift = <0x00>;
						};

						sio_2f {
							offset = <0xf4>;
							bit-mask = <0xff>;
							bit-shift = <0x18>;
						};

						sio_2e {
							offset = <0xf4>;
							bit-mask = <0xff>;
							bit-shift = <0x10>;
						};

						sio_2d {
							offset = <0xf4>;
							bit-mask = <0xff>;
							bit-shift = <0x08>;
						};

						sio_2c {
							offset = <0xf4>;
							bit-mask = <0xff>;
							bit-shift = <0x00>;
						};

						sio_23 {
							offset = <0xf8>;
							bit-mask = <0xff>;
							bit-shift = <0x18>;
						};

						sio_22 {
							offset = <0xf8>;
							bit-mask = <0xff>;
							bit-shift = <0x10>;
						};

						sio_21 {
							offset = <0xf8>;
							bit-mask = <0xff>;
							bit-shift = <0x08>;
						};

						sio_20 {
							offset = <0xf8>;
							bit-mask = <0xff>;
							bit-shift = <0x00>;
						};

						sio_27 {
							offset = <0xfc>;
							bit-mask = <0xff>;
							bit-shift = <0x18>;
						};

						sio_26 {
							offset = <0xfc>;
							bit-mask = <0xff>;
							bit-shift = <0x10>;
						};

						sio_25 {
							offset = <0xfc>;
							bit-mask = <0xff>;
							bit-shift = <0x08>;
						};

						sio_24 {
							offset = <0xfc>;
							bit-mask = <0xff>;
							bit-shift = <0x00>;
						};
					};

					mbox@180 {
						compatible = "aspeed,ast2500-mbox";
						reg = <0x180 0x5c>;
						interrupts = <0x2e>;
						#mbox-cells = <0x01>;
						status = "disabled";
					};
				};
			};

			bus@1e78b000 {
				compatible = "simple-bus";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e78b000 0x60>;

				peci-bus@0 {
					compatible = "aspeed,ast2500-peci";
					reg = <0x00 0x60>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x0f>;
					clocks = <0x02 0x06>;
					resets = <0x02 0x06>;
					clock-frequency = <0x16e3600>;
					msg-timing = <0x01>;
					addr-timing = <0x01>;
					rd-sampling-point = <0x08>;
					cmd-timeout-ms = <0x3e8>;
					status = "disabled";
				};
			};

			serial@1e78d000 {
				compatible = "ns16550a";
				reg = <0x1e78d000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x20>;
				clocks = <0x02 0x0e>;
				resets = <0x0d 0x05>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e78e000 {
				compatible = "ns16550a";
				reg = <0x1e78e000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x21>;
				clocks = <0x02 0x14>;
				resets = <0x0d 0x06>;
				no-loopback-test;
				status = "okay";
			};

			serial@1e78f000 {
				compatible = "ns16550a";
				reg = <0x1e78f000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x22>;
				clocks = <0x02 0x15>;
				resets = <0x0d 0x07>;
				no-loopback-test;
				status = "okay";
			};

			sdhci_slot0@100 {
				compatible = "aspeed,sdhci-ast2500";
				reg = <0x1e740100 0xff>;
				interrupts = <0x1a>;
				sdhci,auto-cmd12;
				clocks = <0x02 0x1c>;
				status = "disabled";
			};

			sdhci_slot1@200 {
				compatible = "aspeed,sdhci-ast2500";
				reg = <0x1e740200 0xff>;
				interrupts = <0x1a>;
				sdhci,auto-cmd12;
				clocks = <0x02 0x1c>;
				status = "disabled";
			};

			uart_sdma@1e79e000 {
				compatible = "aspeed,ast-uart-sdma";
				reg = <0x1e79e000 0x400>;
				interrupts = <0x32>;
				status = "disabled";
			};

			dma_uart0@1e78e000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e78e000 0x1000>;
				interrupts = <0x21>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x02>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x0e 0x0f>;
				status = "disabled";
			};

			dma_uart1@1e78f000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e78f000 0x1000>;
				interrupts = <0x22>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x03>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x0e 0x0f>;
				status = "disabled";
			};

			dma_uart2@1e790000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e790000 0x1000>;
				interrupts = <0x33>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x04>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x10 0x11>;
				status = "disabled";
			};

			dma_uart3@1e791000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e791000 0x1000>;
				interrupts = <0x34>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x05>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x12 0x13>;
				status = "disabled";
			};

			dma_uart4@1e792000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e792000 0x1000>;
				interrupts = <0x35>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x06>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x14 0x15>;
				status = "disabled";
			};

			dma_uart5@1e793000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e793000 0x1000>;
				interrupts = <0x36>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x07>;
				no-loopback-test;
				status = "disabled";
			};

			dma_uart6@1e794000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e794000 0x1000>;
				interrupts = <0x37>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x08>;
				no-loopback-test;
				pinctrl-names = "default";
				pinctrl-0 = <0x16 0x16>;
				status = "disabled";
			};

			dma_uart7@1e795000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e795000 0x1000>;
				interrupts = <0x38>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x09>;
				no-loopback-test;
				status = "disabled";
			};

			dma_uart8@1e796000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e796000 0x1000>;
				interrupts = <0x39>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x0a>;
				no-loopback-test;
				status = "disabled";
			};

			dma_uart9@1e797000 {
				compatible = "aspeed,ast-sdma-uart";
				reg = <0x1e797000 0x1000>;
				interrupts = <0x3a>;
				clock-frequency = <0x16e3600>;
				reg-shift = <0x02>;
				dma-channel = <0x0b>;
				no-loopback-test;
				status = "disabled";
			};
		};
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		framebuffer {
			size = <0x1000000>;
			alignment = <0x1000000>;
			compatible = "shared-dma-pool";
			reusable;
		};
	};

	ami_drivers {
		compatible = "non_dt_devices";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		ami_usbhub {
			interrupts = <0x05>;
		};

		ami_videocap {
			interrupts = <0x07>;
		};

		ami_reset {
			interrupts = <0x08>;
		};

		ami_bt {
			interrupts = <0x08>;
		};

		ami_kcs {
			interrupts = <0x08>;
		};

		ami_lpc {
			interrupts = <0x08>;
		};

		ami_snoop {
			interrupts = <0x08>;
		};

		ami_i2c {
			interrupts = <0x0c>;
		};

		ami_peci {
			interrupts = <0x0f>;
		};

		ami_gpio {
			interrupts = <0x14>;
		};

		ami_espi {
			interrupts = <0x17>;
		};

		ami_pwmtach {
			interrupts = <0x1c>;
		};

		ami_adc {
			interrupts = <0x1f>;
		};

		ami_sgpio_master {
			interrupts = <0x28>;
		};

		ami_sgpio_slave {
			interrupts = <0x29>;
		};

		ami_mctp {
			interrupts = <0x2a>;
		};

		ami_scu {
			interrupts = <0x15>;
		};
	};
};`