	clock-controller@1e6e2000 {
		compatible = "aspeed,ast2500-scu";
		reg = <0x1e6e2000 0x1000>;
		u-boot,dm-pre-reloc;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		phandle = <0x02>;
	};

	reset-controller {
		u-boot,dm-pre-reloc;
		compatible = "aspeed,ast2500-reset";
		aspeed,wdt = <0x19>;
		#reset-cells = <0x01>;
		phandle = <0x0b>;
	};

	sdrammc@1e6e0000 {
		u-boot,dm-pre-reloc;
		compatible = "aspeed,ast2500-sdrammc";
		reg = <0x1e6e0000 0x174 0x1e6e0200 0x1d4>;
		#reset-cells = <0x01>;
		clocks = <0x02 0x23>;
		resets = <0x0b 0x00>;
		clock-frequency = <0x17d78400>;
	};
