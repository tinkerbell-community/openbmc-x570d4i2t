/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	model = "Aspeed BMC";
	compatible = "aspeed,ast2500";
	interrupt-parent = <0x01>;

	chosen {
		stdout-path = "/ahb/apb/serial@1e784000";
	};

	aliases {
		i2c0 = "/ahb/apb/i2c@1e78a000/i2c-bus@40";
		i2c1 = "/ahb/apb/i2c@1e78a000/i2c-bus@80";
		i2c2 = "/ahb/apb/i2c@1e78a000/i2c-bus@c0";
		i2c3 = "/ahb/apb/i2c@1e78a000/i2c-bus@100";
		i2c4 = "/ahb/apb/i2c@1e78a000/i2c-bus@140";
		i2c5 = "/ahb/apb/i2c@1e78a000/i2c-bus@180";
		i2c6 = "/ahb/apb/i2c@1e78a000/i2c-bus@1c0";
		i2c7 = "/ahb/apb/i2c@1e78a000/i2c-bus@300";
		i2c8 = "/ahb/apb/i2c@1e78a000/i2c-bus@340";
		i2c9 = "/ahb/apb/i2c@1e78a000/i2c-bus@380";
		i2c10 = "/ahb/apb/i2c@1e78a000/i2c-bus@3c0";
		i2c11 = "/ahb/apb/i2c@1e78a000/i2c-bus@400";
		i2c12 = "/ahb/apb/i2c@1e78a000/i2c-bus@440";
		i2c13 = "/ahb/apb/i2c@1e78a000/i2c-bus@480";
		serial0 = "/ahb/apb/serial@1e783000";
		serial1 = "/ahb/apb/serial@1e78d000";
		serial2 = "/ahb/apb/serial@1e78e000";
		serial3 = "/ahb/apb/serial@1e78f000";
		serial4 = "/ahb/apb/serial@1e784000";
		serial5 = "/ahb/apb/serial@1e787000";
		spi0 = "/ahb/flash-controller@1e620000";
		ethernet0 = "/ahb/ethernet@1e660000";
		ethernet1 = "/ahb/ethernet@1e680000";
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,arm1176jzf-s";
			device_type = "cpu";
			reg = <0x00>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x00>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		framebuffer {
			size = <0x1000000>;
			alignment = <0x1000000>;
			compatible = "shared-dma-pool";
			reusable;
		};

		video {
			size = <0x4000000>;
			alignment = <0x1000000>;
			compatible = "shared-dma-pool";
			no-map;
		};
	};

	ahb {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		u-boot,dm-pre-reloc;

		flash-controller@1e620000 {
			reg = <0x1e620000 0xc4 0x20000000 0x10000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-fmc";
			status = "okay";
			interrupts = <0x13>;
			clocks = <0x02 0x1a>;

			flash@0 {
				reg = <0x00>;
				compatible = "spi-flash", "sst,w25q256";
				status = "okay";
				spi-max-frequency = <0x2faf080>;
				spi-tx-bus-width = <0x02>;
				spi-rx-bus-width = <0x02>;
			};

			flash@1 {
				reg = <0x01>;
				compatible = "spi-flash", "sst,w25q256";
				status = "okay";
				spi-max-frequency = <0x2faf080>;
				spi-tx-bus-width = <0x02>;
				spi-rx-bus-width = <0x02>;
			};

			flash@2 {
				reg = <0x02>;
				compatible = "jedec,spi-nor";
				status = "disabled";
			};
		};

		flash-controller@1e630000 {
			reg = <0x1e630000 0xc4 0x30000000 0x8000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-spi";
			clocks = <0x02 0x1a>;
			status = "disabled";

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				status = "disabled";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				status = "disabled";
			};
		};

		flash-controller@1e631000 {
			reg = <0x1e631000 0xc4 0x38000000 0x8000000>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "aspeed,ast2500-spi";
			clocks = <0x02 0x1a>;
			status = "disabled";

			flash@0 {
				reg = <0x00>;
				compatible = "jedec,spi-nor";
				status = "disabled";
			};

			flash@1 {
				reg = <0x01>;
				compatible = "jedec,spi-nor";
				status = "disabled";
			};
		};

		interrupt-controller@1e6c0080 {
			compatible = "aspeed,ast2400-vic";
			interrupt-controller;
			#interrupt-cells = <0x01>;
			valid-sources = <0xfefff7ff 0x807ffff>;
			reg = <0x1e6c0080 0x80>;
			phandle = <0x01>;
		};

		ethernet@1e660000 {
			compatible = "aspeed,ast2500-mac", "faraday,ftgmac100";
			reg = <0x1e660000 0x180>;
			interrupts = <0x02>;
			clocks = <0x02 0x11 0x02 0x26>;
			status = "okay";
			phy-mode = "rgmii";
			pinctrl-names = "default";
			pinctrl-0 = <0x03 0x04>;
		};

		ethernet@1e680000 {
			compatible = "aspeed,ast2500-mac", "faraday,ftgmac100";
			reg = <0x1e680000 0x180>;
			interrupts = <0x03>;
			clocks = <0x02 0x12 0x02 0x26>;
			status = "okay";
			phy-mode = "rgmii";
			pinctrl-names = "default";
			pinctrl-0 = <0x05 0x06>;
		};

		usb@1e6a1000 {
			compatible = "aspeed,ast2500-ehci", "generic-ehci";
			reg = <0x1e6a1000 0x100>;
			interrupts = <0x05>;
			status = "disabled";
		};

		usb@1e6a3000 {
			compatible = "aspeed,ast2500-ehci", "generic-ehci";
			reg = <0x1e6a3000 0x100>;
			interrupts = <0x0d>;
			status = "disabled";
		};

		usb@1e6b0000 {
			compatible = "aspeed,ast2500-uhci", "generic-uhci";
			reg = <0x1e6b0000 0x100>;
			interrupts = <0x0e>;
			#ports = <0x02>;
			status = "disabled";
		};

		apb {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			u-boot,dm-pre-reloc;

			syscon@1e6e2000 {
				compatible = "aspeed,g5-scu", "syscon", "simple-mfd";
				reg = <0x1e6e2000 0x1a8>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;

				pinctrl {
					compatible = "aspeed,g5-pinctrl";
					aspeed,external-nodes = <0x07 0x08>;
					phandle = <0x0a>;

					acpi_default {
						function = "ACPI";
						groups = "ACPI";
					};

					adc0_default {
						function = "ADC0";
						groups = "ADC0";
					};

					adc1_default {
						function = "ADC1";
						groups = "ADC1";
					};

					adc10_default {
						function = "ADC10";
						groups = "ADC10";
					};

					adc11_default {
						function = "ADC11";
						groups = "ADC11";
					};

					adc12_default {
						function = "ADC12";
						groups = "ADC12";
					};

					adc13_default {
						function = "ADC13";
						groups = "ADC13";
					};

					adc14_default {
						function = "ADC14";
						groups = "ADC14";
					};

					adc15_default {
						function = "ADC15";
						groups = "ADC15";
					};

					adc2_default {
						function = "ADC2";
						groups = "ADC2";
					};

					adc3_default {
						function = "ADC3";
						groups = "ADC3";
					};

					adc4_default {
						function = "ADC4";
						groups = "ADC4";
					};

					adc5_default {
						function = "ADC5";
						groups = "ADC5";
					};

					adc6_default {
						function = "ADC6";
						groups = "ADC6";
					};

					adc7_default {
						function = "ADC7";
						groups = "ADC7";
					};

					adc8_default {
