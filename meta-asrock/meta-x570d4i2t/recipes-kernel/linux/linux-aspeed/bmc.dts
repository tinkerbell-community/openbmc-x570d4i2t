			hwrng@1e6e2078 {
				compatible = "timeriomem_rng";
				reg = <0x1e6e2078 0x04>;
				period = <0x01>;
				quality = <0x64>;
			};

			display@1e6e6000 {
				compatible = "aspeed,ast2500-gfx", "syscon";
				reg = <0x1e6e6000 0x1000>;
				reg-io-width = <0x04>;
				phandle = <0x07>;
			};

			adc@1e6e9000 {
				compatible = "aspeed,ast2500-adc";
				reg = <0x1e6e9000 0xb0>;
				#io-channel-cells = <0x01>;
				status = "disabled";
			};

			sram@1e720000 {
				compatible = "mmio-sram";
				reg = <0x1e720000 0x9000>;
			};

			sdhci@1e740000 {
				#interrupt-cells = <0x01>;
				compatible = "aspeed,aspeed-sdhci-irq", "simple-mfd";
				reg = <0x1e740000 0x1000>;
				interrupts = <0x1a>;
				interrupt-controller;
				clocks = <0x02 0x16 0x02 0x18>;
				clock-names = "ctrlclk", "extclk";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				ranges = <0x00 0x1e740000 0x1000>;
				phandle = <0x09>;

				sdhci_slot0@100 {
					compatible = "aspeed,sdhci-ast2500";
					reg = <0x100 0x100>;
					interrupts = <0x00>;
					interrupt-parent = <0x09>;
					sdhci,auto-cmd12;
					clocks = <0x02 0x1d>;
					status = "disabled";
				};

				sdhci_slot1@200 {
					compatible = "aspeed,sdhci-ast2500";
					reg = <0x200 0x100>;
					interrupts = <0x01>;
					interrupt-parent = <0x09>;
					sdhci,auto-cmd12;
					clocks = <0x02 0x1d>;
					status = "disabled";
				};
			};

			gpio@1e780000 {
				#gpio-cells = <0x02>;
				gpio-controller;
				compatible = "aspeed,ast2500-gpio";
				reg = <0x1e780000 0x1000>;
				interrupts = <0x14>;
				gpio-ranges = <0x0a 0x00 0x00 0xdc>;
				interrupt-controller;
			};

			timer@1e782000 {
				compatible = "aspeed,ast2400-timer";
				reg = <0x1e782000 0x90>;
				u-boot,dm-pre-reloc;
			};

			serial@1e783000 {
				compatible = "ns16550a";
				reg = <0x1e783000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x09>;
				clocks = <0x02 0x0d>;
				clock-frequency = <0x16e3600>;
				no-loopback-test;
				status = "disabled";
			};

			serial@1e784000 {
				compatible = "ns16550a";
				reg = <0x1e784000 0x20>;
				reg-shift = <0x02>;
				interrupts = <0x0a>;
				clocks = <0x02 0x0f>;
				clock-frequency = <0x16e3600>;
				no-loopback-test;
				status = "okay";
