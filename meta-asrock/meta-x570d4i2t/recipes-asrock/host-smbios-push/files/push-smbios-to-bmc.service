[Unit]
Description=Push host SMBIOS tables to BMC via IPMI MDR
Documentation=https://github.com/tinkerbell-community/openbmc-x570d4i2t
# Run after the IPMI KCS device is available and after boot is "done"
After=network.target
# Only run on real hardware (not in VMs / containers)
ConditionPathExists=/sys/firmware/dmi/tables/smbios_entry_point
ConditionPathExists=/sys/firmware/dmi/tables/DMI
ConditionPathExists=/dev/ipmi0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/push-smbios-to-bmc.py --interface kcs
# Allow some time for ipmid to fully start on the BMC after power-on.
# The script is idempotent so a retry on failure is safe.
Restart=on-failure
RestartSec=15s
StartLimitIntervalSec=120s
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
