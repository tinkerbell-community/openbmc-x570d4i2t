From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenBMC <openbmc@example.com>
Date: Fri, 06 Jun 2026 00:00:00 +0000
Subject: [PATCH] Add color-mode-type media-query to bootstrap index

Set $color-mode-type to media-query so Bootstrap uses
@media (prefers-color-scheme: dark) instead of [data-bs-theme=dark]
attribute selectors for dark mode.

Upstream-Status: Inappropriate [X570D4I-2T board-specific webui-vue theming]

---
 src/assets/styles/bootstrap/_index.scss | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/assets/styles/bootstrap/_index.scss b/src/assets/styles/bootstrap/_index.scss
index 0000000..0000001 100644
--- a/src/assets/styles/bootstrap/_index.scss
+++ b/src/assets/styles/bootstrap/_index.scss
@@ -5,6 +5,9 @@
 @import "../bmc/helpers/colors";
 @import "../bmc/helpers/variables";
 
+// Use media query for color mode instead of data attribute
+$color-mode-type: media-query;
+
 // Import Bootstrap variables and maps
 @import "bootstrap/scss/variables";
 @import "bootstrap/scss/maps";
-- 
