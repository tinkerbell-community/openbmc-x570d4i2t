-        background-color: theme-color-light('danger');
-        fill: theme-color('danger');
+        border-inline-start-color: var(--bs-danger);
+        background-color: var(--bs-danger-bg-subtle);
+        fill: var(--bs-danger);
     }
 
     &.alert-warning {
-        border-inline-start-color: theme-color('warning');
-        background-color: theme-color-light('warning');
-        fill: theme-color('warning');
+        border-inline-start-color: var(--bs-warning);
+        background-color: var(--bs-warning-bg-subtle);
+        fill: var(--bs-warning);
     }
 }
