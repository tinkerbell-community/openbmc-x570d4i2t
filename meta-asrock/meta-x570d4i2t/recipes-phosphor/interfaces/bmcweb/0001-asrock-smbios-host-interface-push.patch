From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ASRock OpenBMC Port <nbatkins@gmail.com>
Date: Sat, 07 Jun 2026 00:00:00 +0000
Subject: [PATCH] asrock: add SMBIOS host-interface push endpoint

Mirror of the AMI Megarac SPX smbios-hi.lua host-interface handler.
The BIOS posts a raw SMBIOS table as multipart/form-data to:

  POST /redfish/v1/Systems/{systemId}/Smbios

The handler writes the blob to /var/lib/smbios/smbios2 with the
phosphor-smbios-mdr MDRSMBIOSHeader prefix (dirVer=1, mdrType=2)
then calls xyz.openbmc_project.Smbios.MDR_V2 / AgentSynchronizeData()
so that smbios-mdrv2app re-parses and re-populates D-Bus inventory.

DELETE removes the cached table (BIOS signals system reset).

Raw binary body (no multipart envelope) is also accepted as a
fallback for tooling that sends the table directly.

Reference: smbios-hi.lua (AMI firmware v01.91.00 decompiled Lua)

Upstream-Status: Inappropriate [X570D4I-2T board-specific OEM Redfish
host-interface endpoint mirroring AMI Megarac SPX behaviour]
---
 redfish-core/lib/oem/asrock/smbios_push.hpp | 226 ++++++++++++++++++++
 redfish-core/src/redfish.cpp                |   3 +
 2 files changed, 229 insertions(+)
 create mode 100644 redfish-core/lib/oem/asrock/smbios_push.hpp

diff --git a/redfish-core/lib/oem/asrock/smbios_push.hpp b/redfish-core/lib/oem/asrock/smbios_push.hpp
new file mode 100644
--- /dev/null
+++ b/redfish-core/lib/oem/asrock/smbios_push.hpp
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) ASRock-Rack Inc.
+//
+// Redfish Host Interface SMBIOS push endpoint for the X570D4I-2T.
+//
+// The AMI Megarac SPX BIOS posts its SMBIOS tables over the in-band
+// Redfish Host Interface (USB NIC) during POST to:
+//
+//   POST /redfish/v1/Systems/{systemId}/Smbios
+//        Content-Type: multipart/form-data
+//        <binary SMBIOS table as first form part>
+//
+// This handler:
+//   1. Extracts the binary payload (multipart or raw body fallback).
+//   2. Prepends a phosphor-smbios-mdr MDRSMBIOSHeader (9 bytes) and
+//      writes the result to /var/lib/smbios/smbios2.
+//   3. Calls xyz.openbmc_project.Smbios.MDR_V2 / AgentSynchronizeData()
+//      so smbios-mdrv2app re-parses the table and re-populates D-Bus.
+//
+// DELETE /redfish/v1/Systems/{systemId}/Smbios removes the cached file.
+//
+// Reference: smbios-hi.lua (AMI firmware v01.91.00 decompiled Lua source)
+
+#pragma once
+
+#include "app.hpp"
+#include "async_resp.hpp"
+#include "dbus_utility.hpp"
+#include "error_messages.hpp"
+#include "logging.hpp"
+#include "multipart_parser.hpp"
+#include "privileges.hpp"
+#include "routing.hpp"
+
+#include <boost/beast/http/status.hpp>
+#include <boost/system/error_code.hpp>
+
+#include <cstdint>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace redfish
+{
+
+// -----------------------------------------------------------------------
+// Constants — must match phosphor-smbios-mdr/include/smbios_mdrv2.hpp
+// -----------------------------------------------------------------------
+
+static constexpr uint8_t     smbiosMdrDirVer = 1;
+static constexpr uint8_t     smbiosMdrTypeII = 2;
+static constexpr const char* smbiosDataFile  = "/var/lib/smbios/smbios2";
+static constexpr const char* smbiosMdrSvc    =
+    "xyz.openbmc_project.Smbios.MDR_V2";
+static constexpr const char* smbiosMdrObj    =
+    "/xyz/openbmc_project/Smbios/MDR_V2";
+static constexpr const char* smbiosMdrIntf   =
+    "xyz.openbmc_project.Smbios.MDR_V2";
+
+// -----------------------------------------------------------------------
+// MDRSMBIOSHeader (9 bytes, packed) — written before the raw SMBIOS blob.
+// Layout must match the struct in phosphor-smbios-mdr smbios_mdrv2.hpp.
+//   dirVer    = mdrDirVersion = 1
+//   mdrType   = mdrTypeII     = 2
+//   timestamp = seconds since epoch
+//   dataSize  = byte length of the SMBIOS table that follows
+// -----------------------------------------------------------------------
+
+#pragma pack(push, 1)
+struct SmbiosMdrFileHeader
+{
+    uint8_t  dirVer;
+    uint8_t  mdrType;
+    uint32_t timestamp;
+    uint32_t dataSize;
+};
+#pragma pack(pop)
+
+// -----------------------------------------------------------------------
+// Write the raw SMBIOS table to the smbios-mdr persistent cache file.
+// -----------------------------------------------------------------------
+
+static bool smbiosPushWriteFile(std::string_view blob)
+{
+    std::error_code ec;
+    std::filesystem::create_directories(
+        std::filesystem::path(smbiosDataFile).parent_path(), ec);
+    if (ec)
+    {
+        BMCWEB_LOG_ERROR("SMBIOS push: mkdir failed: {}", ec.message());
+        return false;
+    }
+
+    SmbiosMdrFileHeader hdr{};
+    hdr.dirVer    = smbiosMdrDirVer;
+    hdr.mdrType   = smbiosMdrTypeII;
+    hdr.timestamp = static_cast<uint32_t>(std::time(nullptr));
+    hdr.dataSize  = static_cast<uint32_t>(blob.size());
+
+    std::ofstream out(smbiosDataFile,
+                      std::ios_base::binary | std::ios_base::trunc);
+    if (!out.is_open())
+    {
+        BMCWEB_LOG_ERROR("SMBIOS push: cannot open {} for writing",
+                         smbiosDataFile);
+        return false;
+    }
+    out.write(reinterpret_cast<const char*>(&hdr),
+              static_cast<std::streamsize>(sizeof(hdr)));
+    out.write(blob.data(), static_cast<std::streamsize>(blob.size()));
+    out.close();
+    return !out.fail();
+}
+
+// -----------------------------------------------------------------------
+// Trigger phosphor-smbios-mdr to re-parse the newly written file.
+// AgentSynchronizeData() reads /var/lib/smbios/smbios2, validates the
+// MDR header, and fires D-Bus property-change signals for all SMBIOS
+// types so that Redfish /Systems/system/Memory, /Processors, etc.
+// are immediately updated.
+// -----------------------------------------------------------------------
+
+static void smbiosPushSync(
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+{
+    dbus::utility::async_method_call(
+        asyncResp,
+        [asyncResp](const boost::system::error_code& ec, bool status) {
+            if (ec)
+            {
+                BMCWEB_LOG_ERROR("SMBIOS AgentSynchronizeData error: {}",
+                                 ec.message());
+                messages::internalError(asyncResp->res);
+                return;
+            }
+            if (!status)
+            {
+                BMCWEB_LOG_ERROR("SMBIOS AgentSynchronizeData returned false");
+                messages::internalError(asyncResp->res);
+                return;
+            }
+            asyncResp->res.result(boost::beast::http::status::ok);
+        },
+        smbiosMdrSvc, smbiosMdrObj, smbiosMdrIntf, "AgentSynchronizeData");
+}
+
+// -----------------------------------------------------------------------
+// Route registration
+// -----------------------------------------------------------------------
+
+inline void requestRoutesAsRockSmbiosPush(App& app)
+{
+    // POST — BIOS uploads raw SMBIOS table (multipart/form-data or raw body)
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Smbios")
+        .privileges({{"ConfigureComponents"}})
+        .methods(boost::beast::http::verb::post)(
+            [](crow::Request& req,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& /*systemId*/) {
+                std::string_view blob;
+
+                // Primary: multipart/form-data (AMI firmware uses this)
+                // req.multipart() lazily parses the body using the
+                // Content-Type boundary already validated by bmcweb.
+                std::span<FormPart> parts = req.multipart();
+                for (const FormPart& part : parts)
+                {
+                    if (!part.content.empty())
+                    {
+                        blob = part.content;
+                        break;
+                    }
+                }
+
+                // Fallback: raw binary body (curl / test tooling)
+                if (blob.empty())
+                {
+                    blob = req.body();
+                }
+
+                if (blob.empty())
+                {
+                    BMCWEB_LOG_ERROR("SMBIOS push: received empty payload");
+                    messages::unrecognizedRequestBody(asyncResp->res);
+                    return;
+                }
+
+                if (!smbiosPushWriteFile(blob))
+                {
+                    messages::internalError(asyncResp->res);
+                    return;
+                }
+
+                smbiosPushSync(asyncResp);
+            });
+
+    // DELETE — BIOS signals that the cached SMBIOS table should be removed
+    BMCWEB_ROUTE(app, "/redfish/v1/Systems/<str>/Smbios")
+        .privileges({{"ConfigureComponents"}})
+        .methods(boost::beast::http::verb::delete_)(
+            [](const crow::Request& /*req*/,
+               const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+               const std::string& /*systemId*/) {
+                std::error_code ec;
+                if (!std::filesystem::exists(smbiosDataFile, ec) || ec)
+                {
+                    messages::resourceNotFound(asyncResp->res,
+                                               "SmbiosTable", "system");
+                    return;
+                }
+                std::filesystem::remove(smbiosDataFile, ec);
+                if (ec)
+                {
+                    BMCWEB_LOG_ERROR("SMBIOS push: delete failed: {}",
+                                     ec.message());
+                    messages::internalError(asyncResp->res);
+                    return;
+                }
+                asyncResp->res.result(boost::beast::http::status::ok);
+            });
+}
+
+} // namespace redfish
diff --git a/redfish-core/src/redfish.cpp b/redfish-core/src/redfish.cpp
--- a/redfish-core/src/redfish.cpp
+++ b/redfish-core/src/redfish.cpp
@@ -64,6 +64,8 @@
 #include "update_service.hpp"
 #include "virtual_media.hpp"

+#include "oem/asrock/smbios_push.hpp"
+
 namespace redfish
 {

@@ -251,6 +253,8 @@ RedfishService::RedfishService(App& app)
     // Note, this must be the last route registered
     requestRoutesRedfish(app);

+    requestRoutesAsRockSmbiosPush(app);
+
     requestRoutesOpenBmcManager(*this);

     validate();
