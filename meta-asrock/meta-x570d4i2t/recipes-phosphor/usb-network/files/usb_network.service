[Unit]
Description=Enable in-band usb0 network (CDC-ECM gadget) for the Redfish Host Interface
# Order after the IPMI host interface so the vhub UDC and the rest of the
# in-band path are already up when we create the gadget.
After=phosphor-ipmi-host.service
Wants=phosphor-ipmi-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/usb-ctrl ecm usb0 on
ExecStop=/usr/bin/usb-ctrl ecm usb0 off

[Install]
WantedBy=multi-user.target
