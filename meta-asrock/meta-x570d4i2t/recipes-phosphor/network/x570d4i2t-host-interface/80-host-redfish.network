# Redfish Host Interface address for the X570D4I-2T.
#
# The AMI host BIOS (authenticating as the HostAutoFW user) connects to
# https://169.254.0.17/redfish/... over the in-band USB-NCM host<->BMC tunnel
# to push SMBIOS (POST .../Smbios) and BIOS configuration (POST /Registries,
# POST/GET/PATCH .../Bios{,/Settings}) — see the bmcweb OEM handlers added by
# recipes-phosphor/interfaces/bmcweb_%.bbappend. bmcweb is bound to this
# address so the BIOS's connection is accepted.
#
# NOTE: phosphor-network is told to ignore usb0 (IGNORED_INTERFACES, see
# phosphor-network_%.bbappend) so it does not generate a competing
# 00-bmc-usb0.network; this static config is what configures usb0.

[Match]
Name=usb0

[Network]
# Static link-local address the BIOS dials. Keep IPv4LL off so networkd does
# not also hand the interface a random 169.254.x.y.
Address=169.254.0.17/16
LinkLocalAddressing=no
DHCP=no
IPv6AcceptRA=no
# The USB-gadget netdev has no carrier until the host enumerates it, but bmcweb
# must already be bound to 169.254.0.17 when the host first connects — so assign
# the address regardless of carrier and keep the link up.
ConfigureWithoutCarrier=yes
IgnoreCarrierLoss=yes

[Link]
RequiredForOnline=no
ActivationPolicy=always-up
