[Unit]
Description=Redfish Host Interface static IP (169.254.0.17) on usb0
# Run after the gadget exists and after networkd has done its initial pass.
After=x570d4i2t-usb-network.service systemd-networkd.service
Wants=x570d4i2t-usb-network.service

[Service]
# systemd-networkd's ConfigureWithoutCarrier does not actually apply the static
# address to this carrier-less CDC-ECM gadget (verified live), so assign it
# directly here. 80-host-redfish.network sets KeepConfiguration=yes so networkd
# does not flush this address when it reconfigures usb0 on carrier changes.
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 40 ] && [ ! -e /sys/class/net/usb0 ]; do sleep 0.25; i=$((i+1)); done'
ExecStart=/bin/sh -c 'ip link set usb0 up 2>/dev/null; ip addr add 169.254.0.17/16 dev usb0 2>/dev/null; ip addr show usb0 | grep -q "169.254.0.17"'

[Install]
WantedBy=multi-user.target
