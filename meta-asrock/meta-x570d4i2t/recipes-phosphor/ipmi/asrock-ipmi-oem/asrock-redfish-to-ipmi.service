[Unit]
Description=ASRock Redfish-to-IPMI translator on the usb0 host interface
# The usb0 gadget + address must exist before we SO_BINDTODEVICE to it.
After=usb_network.service phosphor-ipmi-host.service
Wants=usb_network.service
Requires=phosphor-ipmi-host.service

[Service]
ExecStart=/usr/bin/asrock-redfish-to-ipmi
Restart=on-failure
RestartSec=5
# Needs CAP_NET_RAW for SO_BINDTODEVICE(usb0).
AmbientCapabilities=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
