CompileFlags:
  # Cross-compile flags that clangd doesn't understand — strip them
  Remove:
    - -fmacro-prefix-map=*
    - -ffile-prefix-map=*
    - -fdebug-prefix-map=*
    - -fstack-protector-strong
    - -grecord-gcc-switches
    - --sysroot=*
    - -mfpu=*
    - -mfloat-abi=*
    - -mcpu=*
    - -march=*

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - modernize-use-nullptr
      - readability-braces-around-statements
    Remove:
      - fuchsia-*
      - google-*
      - llvm-*
      - abseil-*

Index:
  Background: Build
